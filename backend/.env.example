# UrbanFlow AI — Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=UrbanFlow AI
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./urbanflow.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/urbanflow

# CORS
FRONTEND_URL=http://localhost:3000

# Data
DATA_TYPE=simulated
# NOTE: This platform uses simulated/synthetic data.
# Do not connect real government traffic APIs without proper authorization.
